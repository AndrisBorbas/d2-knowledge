{
	"name": "d2-knowledge",
	"version": "1.3.1",
	"private": true,
	"scripts": {
		"dev": "bun run assets:prepare && next dev",
		"devs": "bun run assets:prepare && next dev --experimental-https",
		"build": "bun run assets:prepare && next build",
		"start": "next start",
		"lint": "eslint",
		"assets:prepare": "bun run data:minify && bun run assets:icons",
		"assets:icons": "bun run scripts/copy-icons.mts",
		"data:minify": "bun run scripts/minify-dataset.mts",
		"data:compendium:snapshot": "bun run scripts/compile-compendium.mts",
		"data:bungie:snapshot": "bun run scripts/fetch-bungie-manifest.mts",
		"data:clarity:snapshot": "bun run scripts/fetch-clarity.mts",
		"data:compile": "bun run data:clarity:snapshot && bun run data:bungie:snapshot && bun run data:compendium:snapshot"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@tanstack/react-virtual": "^3.14.10",
		"bungie-api-ts": "^5.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fuse.js": "^7.5.0",
		"lucide-react": "^1.34.0",
		"next": "16.3.3",
		"nuqs": "^2.10.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-resizable-panels": "^4.12.3",
		"swetrix": "^4.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^10",
		"eslint-config-next": "16.3.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}